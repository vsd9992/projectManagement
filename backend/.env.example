# Copy to .env (gitignored) and fill in real values. Never commit .env.

# RLS-enforced application role (no BYPASSRLS) — used for all normal request handling.
DATABASE_URL_APP=postgres://app_user:CHANGE_ME@localhost:5432/project_management

# BYPASSRLS role — used only for login-time email lookup and platform-admin tooling.
DATABASE_URL_ADMIN=postgres://app_admin:CHANGE_ME@localhost:5432/project_management

BIND_ADDR=0.0.0.0:8080
